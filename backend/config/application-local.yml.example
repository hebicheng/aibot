# 本地开发私有配置模板（可以提交到仓库，里面不能有真实密钥）
#
# 用法：
#   cp config/application-local.yml.example config/application-local.yml
#   然后把下面各项换成自己的值；application-local.yml 已被 .gitignore 忽略。
#
# 加载方式：Spring Boot 会自动读取「启动工作目录/config/」下的配置，
#   所以在 backend/ 目录下跑 mvn spring-boot:run 时，本文件优先级高于 classpath:application.yml。
#   未显式指定 profile 时默认按 local 启动（application.yml 里 spring.profiles.default）。
#
# 只想先把项目跑起来、不接外部服务时：ai.mock 保持 true、storage.type 保持 local，
#   三处密钥全部留空也能正常启动（聊天走结构化兜底，附件落本地 ./uploads）。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/purchase_ai_bot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: root

security:
  token-secret: local-dev-only-insecure-token-secret

wechat:
  # 小程序 AppID / AppSecret，与 mini-new/project.config.json 里的 appid 保持一致
  app-id: wx_your_appid_here
  app-secret: your_app_secret_here
  # 本地联调：develop（开发版）/ trial（体验版）/ release（正式版）
  # 注意：只有 develop 会开放账号密码登录入口
  qr-env-version: develop

ai:
  # true = 不调用千问，返回结构化兜底结果（无 key 时建议开着）
  mock: true
  qwen:
    api-key: sk-your-dashscope-api-key
    model: qwen3.8-max

storage:
  # local = 存本地 ./uploads；cos = 存腾讯云对象存储
  type: local
  local-dir: ./uploads
  public-base-url: http://localhost:8090/files
  cos:
    secret-id:
    secret-key:
    region: ap-guangzhou
    bucket:
