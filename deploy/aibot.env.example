# AI-BOT 后端运行时配置模板（systemd EnvironmentFile 读取）
#
# 用法（服务器上）：
#   cp deploy/aibot.env.example /opt/aibot/.env
#   chmod 600 /opt/aibot/.env
#   把下面的占位值改成真实值，然后 systemctl restart aibot-backend
#
# 注意：真实值的 /opt/aibot/.env 不在仓库里（deploy/aibot.env 已被 .gitignore 忽略），
#       仓库里只保留这份占位模板。

SERVER_PORT=8090

# 时区：所有定时任务（对账单预约/周提醒/爬虫）用 JVM 默认时区比较 LocalDateTime，
# 服务器系统时区若为 UTC 会导致推送晚 8 小时，这里强制 GMT+8。
TZ=Asia/Shanghai

# 数据库
DB_URL=jdbc:mysql://localhost:3306/purchase_ai_bot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT：生产务必换成足够长的随机串
TOKEN_SECRET=change-me-to-a-long-random-secret
TOKEN_TTL_SECONDS=604800

# 微信小程序（与 mini-new 的 AppID 必须一致）
WECHAT_APP_ID=wx_your_appid_here
WECHAT_APP_SECRET=your-app-secret
WECHAT_MOCK_LOGIN=false

# 小程序码扫码登录：
#   WECHAT_QR_PAGE —— 扫码后打开的小程序页面（须在 app.json 注册，默认 pages/login/confirm）
#   WECHAT_QR_ENV —— 小程序版本，必须和当前发布状态匹配，否则生成小程序码失败：
#                    本地联调 = develop（开发版）  |  体验版 = trial  |  正式上线 = release
#   注意：getwxacodeunlimit 的 scene 上限 32 字符，当前 state 正好 32，切勿加前缀。
#   注意：QrLoginService 的扫码会话存在 JVM 内存，仅单机有效；多实例/集群需改 Redis。
WECHAT_QR_PAGE=pages/login/confirm
WECHAT_QR_ENV=trial

# AI
AI_MOCK=false
QWEN_API_KEY=your-qwen-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT=120

# 对象存储（不需要 COS 时把 STORAGE_TYPE 改成 local，密钥留空）
STORAGE_TYPE=cos
STORAGE_PUBLIC_BASE_URL=https://your-bucket.cos.ap-guangzhou.myqcloud.com
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket

# 跨域 / 爬虫
CORS_ALLOWED_ORIGINS=*
# 爬虫开关（启动拉取 / 定时拉取独立控制）
APP_CRAWLER_ENABLED_ON_STARTUP=false
APP_CRAWLER_ENABLED_SCHEDULED=false
