/* ============================================================
   智能助理聊天页：对话流、四类业务卡片、底部输入器
   布局原则：flex 自适应宽度，任何机型不溢出。
   ============================================================ */

/* ---------- 引导态 ---------- */
.ws-onboard {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  text-align: center;
}
.ws-onboard-glow {
  position: absolute;
  top: 22%;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(74, 108, 247, 0.16), rgba(74, 108, 247, 0));
  filter: blur(10rpx);
}
.ws-onboard-icon {
  width: 132rpx;
  height: 132rpx;
  border-radius: 40rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  box-shadow: var(--shadow);
}
.ws-onboard-title { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.ws-onboard-sub { font-size: 25rpx; color: var(--ink-3); margin-top: 14rpx; max-width: 520rpx; line-height: 1.65; }
.ws-onboard-btn { width: 340rpx; margin-top: 44rpx; }

/* ---------- 滚动区 ---------- */
.chat-scroll { position: fixed; left: 0; right: 0; }
.chat-list {
  padding: 96rpx 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* ---------- 当前建议（跟随消息流置于底部，对齐 Web 侧边栏下一步建议） ---------- */
.next-steps {
  margin: 10rpx 4rpx 4rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.next-steps-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 22rpx 24rpx 14rpx;
}
.next-steps-head-left { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.next-steps-head-ico {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.next-steps-head-title { font-size: 28rpx; font-weight: 600; color: var(--ink-2); letter-spacing: 0.3rpx; }
.next-steps-head-actions { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; }
.next-steps-count {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.next-steps-toggle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.next-steps-toggle-hover { background: #dde9ff; }
.next-steps-label {
  padding: 0 24rpx 12rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--ink-4);
}
.next-steps-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 18rpx 24rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
}
.next-steps-more-hover { background: var(--brand-soft); }
.next-step-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-top: 2rpx solid var(--line);
}
.next-step-row-hover { background: var(--surface-2); }
.next-step-row-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.next-step-row-copy { flex: 1; min-width: 0; }
.next-step-row-title { font-size: 27rpx; font-weight: 600; color: var(--ink); }
.next-step-row-detail { font-size: 21rpx; color: var(--ink-3); margin-top: 4rpx; }
.next-step-row-go { flex-shrink: 0; }
.next-steps-empty {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 26rpx 24rpx;
  border-top: 2rpx solid var(--line);
}
.next-steps-empty-text { font-size: 23rpx; color: var(--ink-3); }
.next-steps-foot {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 24rpx;
  border-top: 2rpx solid var(--line);
  background: var(--surface-2);
}
.next-steps-foot-hover { background: var(--surface-3); }
.next-steps-foot-ico {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.next-steps-foot-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.next-steps-foot-title { font-size: 25rpx; font-weight: 600; color: var(--ink); }
.next-steps-foot-sub { font-size: 20rpx; color: var(--ink-3); }

.list-end { height: 24rpx; }

/* ---------- 消息行（自适应，不溢出） ---------- */
.msg { display: flex; align-items: flex-start; gap: 14rpx; width: 100%; }
.msg-user { flex-direction: row-reverse; }
.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-avatar-user {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}
.msg-stack {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
}
.msg-user .msg-stack { align-items: flex-end; }

/* ---------- 气泡 ---------- */
.bubble {
  max-width: 100%;
  padding: 18rpx 22rpx;
  font-size: 27rpx;
  line-height: 1.6;
  border-radius: 22rpx;
  word-break: break-word;
  white-space: pre-wrap;
}
.bubble-ai {
  background: var(--surface);
  color: var(--ink);
  border-top-left-radius: 8rpx;
  box-shadow: var(--shadow);
}
.bubble-user {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #fff;
  border-top-right-radius: 8rpx;
  box-shadow: 0 8rpx 22rpx rgba(74, 108, 247, 0.24);
}
.bubble-failed { background: var(--red-soft); color: var(--red); box-shadow: none; }
.bubble-file { padding: 16rpx; }

.file-chip { display: flex; align-items: center; gap: 14rpx; }
.file-chip-ico {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bubble-ai .file-chip-ico { background: var(--brand-soft); }
.file-chip-copy { min-width: 0; }
.file-chip-name { font-size: 26rpx; font-weight: 600; }
.file-chip-sub { font-size: 21rpx; opacity: 0.75; margin-top: 2rpx; }
.file-chip-guide {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.22);
  font-size: 23rpx;
  opacity: 0.92;
}
.bubble-ai .file-chip-guide { border-top-color: var(--line); color: var(--ink-3); }

.msg-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.msg-time { font-size: 20rpx; color: var(--ink-4); padding: 0 6rpx; }

/* AI 消息下方：本次消耗积分（与时间同一行，普通文本色） */
.msg-credits { padding: 0 6rpx; font-size: 20rpx; color: var(--ink-4); font-weight: 400; }
.msg-credits::before { content: "·"; margin-right: 6rpx; color: var(--line); }

/* 失败消息操作（重试 / 删除） */
.msg-failed-actions { display: flex; align-items: center; gap: 10rpx; margin-top: 6rpx; padding: 0 6rpx; }
.msg-failed-btn {
  height: 44rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-ink);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.msg-failed-btn.is-ghost { background: var(--surface-2); color: var(--ink-3); }

/* ============================================================
   业务卡片（对齐 Web chat-recognition-card）
   ============================================================ */
.doc-card {
  width: 100%;
  align-self: stretch;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.doc-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 20rpx 16rpx;
  border-bottom: 2rpx solid var(--line);
}
.doc-head-ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.doc-head-text { flex: 1; min-width: 0; padding-top: 2rpx; }
.doc-head-title { font-size: 28rpx; font-weight: 700; color: var(--ink); line-height: 1.3; }
.doc-head-sub { font-size: 21rpx; color: var(--ink-3); margin-top: 4rpx; line-height: 1.4; }
.doc-head .badge { flex-shrink: 0; margin-top: 4rpx; }

.doc-body { padding: 20rpx; display: flex; flex-direction: column; gap: 18rpx; }

/* 用户处理说明 */
.doc-guidance {
  padding: 16rpx 18rpx;
  background: var(--brand-soft);
  border-radius: var(--radius-sm);
}
.doc-guidance text { font-size: 20rpx; color: var(--brand-ink); font-weight: 600; }
.doc-guidance view { font-size: 25rpx; color: var(--ink); margin-top: 6rpx; line-height: 1.5; }

/* 字段网格 */
.doc-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 12rpx;
}
.doc-cell { width: calc(50% - 6rpx); min-width: 0; }
.doc-cell text { display: block; font-size: 21rpx; color: var(--ink-3); }
.doc-cell view { font-size: 26rpx; font-weight: 600; color: var(--ink); margin-top: 5rpx; line-height: 1.35; }
.doc-cell-hl { color: var(--brand-ink) !important; font-size: 29rpx !important; font-weight: 700 !important; }

/* 材料明细表（横向滚动，对齐 Web 七列） */
.doc-mat {
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.doc-mat-scroll { width: 100%; }
.doc-mat-table { display: inline-block; min-width: 100%; }
.doc-mat-row {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  border-top: 2rpx solid var(--line);
  white-space: nowrap;
}
.doc-mat-row:first-child { border-top: none; }
.doc-mat-head {
  background: var(--surface-2);
  color: var(--ink-3);
  font-size: 20rpx;
  font-weight: 600;
}
.doc-mat-row text { flex-shrink: 0; padding-right: 18rpx; overflow: hidden; text-overflow: ellipsis; }
.doc-mat-row text:last-child { padding-right: 0; }
.doc-mat-row .c1 { width: 176rpx; font-weight: 600; color: var(--ink); }
.doc-mat-row .c2 { width: 132rpx; }
.doc-mat-row .c3 { width: 116rpx; }
.doc-mat-row .c4 { width: 128rpx; }
.doc-mat-row .c5 { width: 132rpx; }
.doc-mat-row .c6 { width: 158rpx; }
.doc-mat-row .c7 { width: 146rpx; font-weight: 600; color: var(--ink); }

/* 金额差异 */
.discrepancy {
  padding: 18rpx;
  background: var(--orange-soft);
  border-radius: var(--radius-sm);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.discrepancy-head { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; font-weight: 600; color: #c8781f; }
.discrepancy-grid { display: flex; gap: 12rpx; }
.mini-field { flex: 1; min-width: 0; background: #fff; border-radius: 12rpx; padding: 12rpx 14rpx; }
.mini-field text { font-size: 20rpx; color: var(--ink-3); }
.mini-field view { font-size: 25rpx; font-weight: 700; color: var(--ink); margin-top: 4rpx; }

/* 缺失字段 / 说明 */
.doc-missing {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 13rpx 16rpx;
  background: var(--orange-soft);
  color: #c8781f;
  border-radius: var(--radius-sm);
  font-size: 23rpx;
  font-weight: 500;
}

/* 发票方向 / 结算归属聚焦确认（对齐 Web focused-confirmation） */
.focus-confirm {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 16rpx;
  background: var(--surface-2);
  border-radius: var(--radius-sm);
}
.focus-confirm-copy { display: flex; flex-direction: column; gap: 4rpx; }
.focus-confirm-title { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.focus-confirm-sub { font-size: 21rpx; color: var(--ink-3); line-height: 1.5; }
.focus-confirm .doc-actions { gap: 12rpx; }
.focus-confirm .card-btn { font-size: 25rpx; }
.doc-note {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.55;
}
.doc-note xicon { flex-shrink: 0; margin-top: 3rpx; }

/* 卡片动作 */
.doc-actions { display: flex; gap: 14rpx; }
.doc-actions-col { flex-direction: column; }
.card-btn { flex: 1; height: 84rpx; font-size: 27rpx; }
.card-btn-block { width: 100%; flex: none; }
.card-link { font-size: 25rpx; color: var(--brand-ink); font-weight: 600; padding: 10rpx 2rpx; }

/* 重复对比 */
.dup-compare { display: flex; align-items: stretch; gap: 12rpx; }
.dup-side {
  flex: 1;
  min-width: 0;
  background: var(--surface-2);
  border-radius: var(--radius-sm);
  padding: 16rpx;
  text-align: center;
}
.dup-side text { font-size: 20rpx; color: var(--ink-3); }
.dup-side view { font-size: 24rpx; font-weight: 600; color: var(--ink); margin: 8rpx 0; }
.dup-side strong, .dup-side-amount { font-size: 27rpx; color: var(--brand-ink); font-weight: 700; }
.dup-arrow { display: flex; align-items: center; flex-shrink: 0; }

/* 澄清 */
.clarify-q { font-size: 27rpx; color: var(--ink); line-height: 1.6; font-weight: 500; }
.clarify-conflict { display: flex; gap: 12rpx; }
.clarify-conflict view { flex: 1; min-width: 0; background: var(--surface-2); border-radius: 12rpx; padding: 14rpx 16rpx; }
.clarify-conflict view > text:first-child { font-size: 20rpx; color: var(--ink-3); }
.clarify-conflict strong, .clarify-conflict-val { display: block; font-size: 25rpx; font-weight: 600; color: var(--ink); margin-top: 5rpx; }

/* 操作结果卡片（对齐 Web operation-result） */
.op-card {
  width: 100%;
  align-self: stretch;
  background: var(--surface);
  border: 2rpx solid #cdeede;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  overflow: hidden;
}
.op-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 20rpx 16rpx;
  background: linear-gradient(135deg, #e7f7ef, #eefaf4);
}
.op-check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.op-head-text { flex: 1; min-width: 0; }
.op-summary { font-size: 27rpx; font-weight: 700; color: var(--ink); line-height: 1.35; }
.op-sub { font-size: 21rpx; color: #0f8f52; margin-top: 3rpx; }
.op-ref {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 20rpx;
}
.op-ref-cell { flex: 1; min-width: 0; }
.op-ref-cell text { display: block; font-size: 20rpx; color: var(--ink-3); }
.op-ref-cell view { font-size: 26rpx; font-weight: 600; color: var(--ink); margin-top: 5rpx; }
.op-ref-right { text-align: right; }
.op-ref-amt { color: #0f8f52 !important; font-weight: 700 !important; }

/* ---------- 处理中 ---------- */
.processing {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border-radius: 22rpx;
  border-top-left-radius: 8rpx;
  box-shadow: var(--shadow);
}
.processing-copy view { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.processing-copy text { font-size: 22rpx; color: var(--ink-3); }
.typing { display: flex; gap: 8rpx; }
.typing-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--brand-2); animation: typing 1s infinite ease-in-out; }
.typing-dot:nth-child(2) { animation-delay: 0.15s; }
.typing-dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes typing { 0%, 60%, 100% { transform: translateY(0); opacity: 0.4; } 30% { transform: translateY(-8rpx); opacity: 1; } }

.chat-error {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  background: var(--red-soft);
  color: var(--red);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
}

/* ============================================================
   底部输入器（豆包风格）
   ============================================================ */
.composer-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 2rpx solid var(--line);
  padding: 14rpx 20rpx 0;
}
.composer-attach { margin-bottom: 12rpx; }
.attach-card { display: flex; align-items: center; gap: 14rpx; padding: 14rpx 16rpx; background: var(--surface-2); border-radius: var(--radius-sm); }
.attach-ico { width: 56rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.attach-copy { flex: 1; min-width: 0; }
.attach-name { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.attach-sub { font-size: 21rpx; color: var(--ink-3); margin-top: 2rpx; }
.attach-remove { width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--surface-3); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

.quick-scroll { white-space: nowrap; margin-bottom: 12rpx; }
.quick-row { display: inline-flex; gap: 12rpx; padding: 2rpx; }
.quick-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 11rpx 20rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  font-size: 23rpx;
  color: var(--ink-2);
  font-weight: 500;
}

.composer { display: flex; align-items: flex-end; gap: 12rpx; }
.composer-tool {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 输入框容器：负责与两侧按钮 72rpx 等高的视觉高度（textarea auto-height 下 min-height 不可靠，
   且真机 textarea 自带额外内边距会撑高，因此 textarea 自身 padding 归零、行高固定，内边距全部在容器上） */
.composer-field {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 180rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 8rpx 24rpx;
  overflow: hidden;
  background: var(--surface-2);
  border-radius: 20rpx;
}
.composer-input {
  width: 100%;
  max-height: 164rpx;
  padding: 0;
  font-size: 27rpx;
  line-height: 40rpx;
  color: var(--ink);
}
.composer-ph { color: var(--ink-4); }
.composer-send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--surface-3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s;
}
.composer-send.is-active {
  background: var(--brand);
  box-shadow: 0 8rpx 18rpx rgba(47, 102, 246, 0.24);
}
